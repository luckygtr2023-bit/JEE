# API listener
PORT=3000
HOST=0.0.0.0

# Required: generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DATA_FILE=./data/store.json

# Optional Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact URL as an authorized redirect URI with Google.
GOOGLE_REDIRECT_URI=https://api.your-domain.example/auth/google/callback

# Restrict this to origins you control when serving a web build. The Android app's
# bundled file origin may be `null`; the API uses bearer tokens, not cookies.
CORS_ORIGINS=*
